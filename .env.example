# Nano Banana Studio 環境變數

# 資料庫路徑（選填，預設為 ./data/nano-banana.sqlite）
# DATABASE_PATH=./data/nano-banana.sqlite

# Gemini API Key（在應用內設定，此處僅作示範）
# GEMINI_API_KEY=your_api_key_here

# 資料庫預設資料載入控制
# 設定為 false 可以禁用預設資料載入（適合正式環境）
# 設定為 true 或不設定則會載入預設樣板和詞庫資料（適合開發環境）
LOAD_DEFAULT_DATA=true

# 開發環境
NODE_ENV=development
